{
  "manifest_version": 3,
  "name": "FOUNDRY",
  "version": "1.1",
  "description": "Send code blocks from AI chat sites to VS Code",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://web.kimi.ai/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.kimi.ai/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}